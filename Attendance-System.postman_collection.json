{
  "info": {
    "name": "Attendance & User Management - Full API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [

    {
      "name": "AUTH",
      "item": [
        {
          "name": "Login (Admin / Employee)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "http://localhost:5000/api/auth/login"
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Super Admin\",\n  \"email\": \"admin@test.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "http://localhost:5000/api/auth/register-admin"
          }
        },
        {
          "name": "Register Employee (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Employee One\",\n  \"email\": \"emp1@test.com\",\n  \"password\": \"123456\",\n  \"salary\": 15000\n}"
            },
            "url": "http://localhost:5000/api/auth/register"
          }
        }
      ]
    },

    {
      "name": "USERS (ADMIN)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "http://localhost:5000/api/users"
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "http://localhost:5000/api/users/1"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Employee Updated\",\n  \"email\": \"emp1@test.com\",\n  \"salary\": 18000\n}"
            },
            "url": "http://localhost:5000/api/users/1"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "http://localhost:5000/api/users/1"
          }
        }
      ]
    },

    {
      "name": "ADMINS (ADMIN)",
      "item": [
        {
          "name": "Get All Admins",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "http://localhost:5000/api/auth/admins"
          }
        },
        {
          "name": "Delete Admin",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "http://localhost:5000/api/auth/admins/1"
          }
        }
      ]
    },

    {
      "name": "ATTENDANCE (EMPLOYEE)",
      "item": [
        {
          "name": "Check In",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employee_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"location\": \"Office\" }"
            },
            "url": "http://localhost:5000/api/attendance/check-in"
          }
        },
        {
          "name": "Check Out",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{employee_token}}" }],
            "url": "http://localhost:5000/api/attendance/check-out"
          }
        },
        {
          "name": "My Attendance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{employee_token}}" }],
            "url": "http://localhost:5000/api/attendance/my"
          }
        }
      ]
    },

    {
      "name": "ATTENDANCE (ADMIN)",
      "item": [
        {
          "name": "Get All Attendance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "http://localhost:5000/api/attendance"
          }
        },
        {
          "name": "Update Attendance",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"present\",\n  \"notes\": \"Manual correction\"\n}"
            },
            "url": "http://localhost:5000/api/attendance/1"
          }
        },
        {
          "name": "Delete Attendance",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "http://localhost:5000/api/attendance/1"
          }
        }
      ]
    }

  ]
}
